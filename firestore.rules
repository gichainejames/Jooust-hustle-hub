rules_version = '2';
service cloud.firestore { match /databases/{d}/documents {
  match /users/{u} { allow read: if true; allow write: if request.auth.uid == u; }
  match /products/{p} {
    allow read: if true;
    allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    allow update, delete: if resource.data.uid == request.auth.uid;
  }
  match /rentals/{r} {
    allow read: if true;
    allow create: if request.auth != null && request.resource.data.uid == request.auth.uid;
    allow update, delete: if resource.data.uid == request.auth.uid;
  }
  match /reports/{r} {
    allow create: if request.auth != null && request.resource.data.by == request.auth.uid;
  }
  match /chats/{c} {
    allow read, update: if request.auth.uid in resource.data.users;
    allow create: if request.auth.uid in request.resource.data.users;
    match /m/{m} {
      allow read, create: if request.auth.uid in get(/databases/$(d)/documents/chats/$(c)).data.users;
    }
  }
} }
