{
 "hosting": {
  "public": ".",
  "ignore": [
   "firebase.json",
   "**/.*",
   "firebase-debug.log",
   "firestore.rules"
  ],
  "headers": [
   {
    "source": "**/*.@(html|js|json)",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "no-cache"
     }
    ]
   },
   {
    "source": "**/*.@(png|svg|ico)",
    "headers": [
     {
      "key": "Cache-Control",
      "value": "public, max-age=86400"
     }
    ]
   }
  ]
 },
 "firestore": {
  "rules": "firestore.rules"
 }
}